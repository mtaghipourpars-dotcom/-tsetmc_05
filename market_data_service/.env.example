BRS_API_KEY=
DATABASE_URL=postgresql+psycopg://market:market@localhost:5432/market
POSTGRES_PASSWORD=market
ADMIN_TOKEN=replace-with-a-long-random-value
READ_TOKEN=
# Empty SELECTED_SYMBOLS means every active symbol. Start small to control API quota.
SELECTED_SYMBOLS=فملی,فولاد,خودرو
NAV_SYMBOLS=اهرم,عیار
MARKET_TYPES=1,2,3,4,5
REQUEST_INTERVAL=1.0
REQUEST_TIMEOUT=30
MAX_RETRIES=3
MAX_RETRY_WAIT=120
CODAL_MAX_PAGES=100
LOG_PATH=logs/market.jsonl

# Direct official services are the primary provider.
DATA_PROVIDER=tsetmc
BRS_FALLBACK_ENABLED=false
TSETMC_BASE_URLS=https://cdn.tsetmc.com,https://cdn10.tsetmc.com
# Optional: your own authorized proxy, e.g. http://user:password@your-host:3128
TSETMC_PROXY_URL=
